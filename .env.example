# Core runtime
NODE_ENV=production
PORT=61262
LOG_LEVEL=info
HTTP_TIMEOUT_MS=12000

# Provider API keys
TMDB_API_KEY="YOUR_TMDB_API_KEY"
MDBLIST_API_KEY="YOUR_MDBLIST_API_KEY"
PUBLICMETADB_API_KEY=""

# Provider endpoints
TMDB_API_URL="https://api.themoviedb.org/3"
MDBLIST_API_URL="https://api.mdblist.com"
PUBLICMETADB_API_URL="https://publicmetadb.com/api"
JIKAN_API_URL="https://api.jikan.moe/v4"
IMDB_BASE_URL="https://www.imdb.com"

# Legacy scraper endpoints kept for compatibility while older providers remain in the codebase
METACRITIC_BASE_URL="https://www.metacritic.com"
ROTTENTOMATOES_BASE_URL="https://www.rottentomatoes.com"

# Cache / Redis
REDIS_URL="redis://ratings-redis:6379"
CACHE_TTL_SECONDS=86400
NEGATIVE_CACHE_TTL_SECONDS=21600

# Display and ordering
DISPLAY_MODE=full
COMPACT_RATINGS_LIMIT=4
ENABLED_RATINGS="Common Sense,Not Safe,Sexual Violence,Sex & Nudity,IMDb (Movie),IMDb (Show),IMDb (Episode),TMDb (Movie),TMDb (Show),TMDb (Episode),MC,RT,PC,Trakt,MAL,Letterboxd,Roger Ebert"
RATINGS_ORDER="Common Sense,Not Safe,Sexual Violence,Sex & Nudity,IMDb (Episode),IMDb (Show),IMDb (Movie),TMDb (Episode),TMDb (Show),TMDb (Movie),MAL,Letterboxd,MC,RT,PC,Trakt,Roger Ebert"

# Frontend / manifest
VITE_HOME_BLURB="Discover ratings from multiple sources in one place!"
ADDON_SUFFIX=""
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"

# VPS deployment wrapper
DOCKER_NETWORK=aio_default
RATINGS_HOSTNAME=ratings.example.com
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
RATINGS_IMAGE=ratings-aggregator
RATINGS_CONTAINER_NAME=ratings-aggregator
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_NAME=ratings-redis
RATINGS_IMDB_DATA_DIR=/opt/docker/data/ratings/imdb
RATINGS_REDIS_DATA_DIR=/opt/docker/data/ratings/redis
