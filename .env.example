# Core runtime
NODE_ENV=production
PORT=61262
LOG_LEVEL=info
HTTP_TIMEOUT_MS=12000

# Optional server-default provider keys used only as UI defaults
TMDB_API_KEY=""
MDBLIST_API_KEY=""
PUBLICMETADB_API_KEY=""
# PublicMetaDB fallback mode: auto, compare, force, off. Use compare/force only for diagnostics.
PUBLICMETADB_FALLBACK_MODE=auto

# Provider endpoints
TMDB_API_URL="https://api.themoviedb.org/3"
MDBLIST_API_URL="https://api.mdblist.com"
PUBLICMETADB_API_URL="https://publicmetadb.com"
JIKAN_API_URL="https://api.jikan.moe/v4"
IMDB_BASE_URL="https://www.imdb.com"
IMDB_DATASET_MODE=required
IMDB_DATA_DIR="/app/data/imdb"
IMDB_DATASET_BATCH_SIZE=5000
IMDB_EPISODE_CACHE_TTL_SECONDS=604800

# Direct safety scraper endpoints used by the hybrid/direct safety modes
COMMONSENSE_BASE_URL="https://www.commonsensemedia.org"
CRINGEMDB_BASE_URL="https://cringemdb.com"

# Cache / Redis (Redis is required by default; set REDIS_REQUIRED=false
# only for local dev/test runs without a running Redis instance)
REDIS_URL="redis://ratings-redis:6379"
REDIS_REQUIRED=true
CACHE_TTL_SECONDS=86400
NEGATIVE_CACHE_TTL_SECONDS=21600

# Persistent app storage
# CONFIG_STORE_DRIVER selects the user-config store backend.
#   sqlite   - default; uses SQLITE_DB_PATH
#   postgres - uses CONFIG_DATABASE_URL (e.g. postgres://user:pass@host:5432/db)
CONFIG_STORE_DRIVER=sqlite
SQLITE_DB_PATH="/app/data/app/ratings.sqlite"
# Postgres-only settings (ignored when CONFIG_STORE_DRIVER=sqlite)
CONFIG_DATABASE_URL=""
CONFIG_DATABASE_POOL_MAX=10
CONFIG_DATABASE_IDLE_TIMEOUT_MS=30000
CONFIG_DATABASE_CONNECTION_TIMEOUT_MS=5000
# Set CONFIG_DATABASE_SSL=require for managed Postgres (RDS, Neon, etc.)
CONFIG_DATABASE_SSL=
LMDB_DATA_DIR="/app/data/lmdb"
CONFIG_ENCRYPTION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Display and ordering
DISPLAY_MODE=auto
COMPACT_RATINGS_LIMIT=4
ENABLED_RATINGS="Content Safety,IMDb (Movie),IMDb (Show),IMDb (Episode),TMDb (Movie),TMDb (Show),TMDb (Episode),MC,RT,PC,Trakt,MAL,Letterboxd,Roger Ebert"
RATINGS_ORDER="IMDb (Episode),IMDb (Show),IMDb (Movie),TMDb (Episode),TMDb (Show),TMDb (Movie),MAL,Letterboxd,MC,RT,PC,Trakt,Roger Ebert"
# Internal server-level safety strategy. Keep hybrid for production unless debugging.
# Options: hybrid, direct, mdblist_conservative
SAFETY_SOURCE=hybrid

# Frontend / manifest
VITE_HOME_BLURB="Discover ratings from multiple sources in one place!"
ADDON_SUFFIX=""
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"

# VPS deployment wrapper
DOCKER_NETWORK=aio_default
RATINGS_HOSTNAME=ratings.example.com
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
RATINGS_IMAGE=ratings-aggregator
RATINGS_CONTAINER_NAME=ratings-aggregator
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_NAME=ratings-redis
RATINGS_IMDB_DATA_DIR=/opt/docker/data/ratings/imdb
RATINGS_REDIS_DATA_DIR=/opt/docker/data/ratings/redis
RATINGS_APP_DATA_DIR=/opt/docker/data/ratings/app
RATINGS_LMDB_DATA_DIR=/opt/docker/data/ratings/lmdb
